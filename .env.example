# Optional settings for the practice-systems HTTP server (`npm run api`).
# The web app itself needs no environment configuration and no secrets.
#
# Copy to .env and export the variables in your shell if you want to change them,
# e.g.  PORT=9000 npm run api

# Port for the HTTP server (default 8787)
PORT=8787

# Fault injection on start-up, as JSON (default: none). Modes: timeout, slow, unavailable, flaky, malformed, rate_limit
# FAULTS={"carrier":"flaky"}

# Cap on simulated latency in milliseconds (a timeout fault otherwise holds the connection ~30 s)
# MAX_LATENCY_MS=30000
